{
  "App": {
    "SelfUrl": "http://localhost:9000",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=(LocalDb)\\MSSQLLocalDB;Database=RCS;Trusted_Connection=True;TrustServerCertificate=true"
  },
  "AuthServer": {
    "Authority": "http://localhost:9000",
    "RequireHttpsMetadata": false,
    "SwaggerClientId": "RCS_Swagger",
    "CertificatePassPhrase": "..."
  },
  "Tm": {
    "Mode": "Sim",
    "BaseUrl": "http://127.0.0.1:9999",
    "TaskAddPath": "api/v1/xinsong/task_add"
  },
  "Mes": {
    "Mode": "Sim",
    "BaseUrl": "http://127.0.0.1:9998",
    "JobResultReportPath": "api/v1/mes/RCS2MES_Job_Result_Report"
  },
  "OptionCode": {
    "SchemaCode": "txc_demo",
    "SchemaVersion": 1
  },
  "StringEncryption": {
    "DefaultPassPhrase": "7c06qpNR9iCIJqM8"
  }}